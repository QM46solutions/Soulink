# ---- Soulink server config (copy to .env) ----
PORT=4000
NODE_ENV=development
# Microsoft SQL Server connection (SETUP-SOULINK.bat fills these in for you)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=soulink
DB_USER=soulink
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
# Change this to any long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# console = print OTPs in this terminal (free, for local testing)
SMS_PROVIDER=console
# In development the API also returns the OTP so the app can auto-fill it
OTP_DEV_ECHO=true

# local = files saved in ./uploads   (s3 later)
STORAGE=local

# claude = use Claude API (needs key), local = free built-in fallback
AI_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# local = open-source model on this laptop, rekognition = AWS (later)
FACE_PROVIDER=local
