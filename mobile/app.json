{
  "expo": {
    "name": "Soulink",
    "slug": "soulink",
    "scheme": "soulink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0f",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.soulink.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Soulink uses the camera for face verification and to take photos you choose to share.",
        "NSPhotoLibraryUsageDescription": "Soulink lets you choose photos for your profile and posts.",
        "NSMicrophoneUsageDescription": "Soulink uses the microphone to record voice messages you choose to send.",
        "NSLocationWhenInUseUsageDescription": "Soulink uses your location once to fill in your city. You can always type it instead.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:soulink-xvbd.onrender.com"
      ],
      "buildNumber": "1"
    },
    "android": {
      "package": "app.soulink.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#07051a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "soulink-xvbd.onrender.com",
              "pathPrefix": "/p/"
            },
            {
              "scheme": "https",
              "host": "soulink-xvbd.onrender.com",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "soulink-xvbd.onrender.com",
              "pathPrefix": "/join/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Soulink lets you choose photos for your profile and posts.",
          "cameraPermission": "Soulink uses the camera for face verification and to take photos you choose to share."
        }
      ],
      "expo-font",
      "expo-splash-screen",
      [
        "expo-audio",
        {
          "microphonePermission": "Soulink uses the microphone to record voice messages you choose to send."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Soulink uses the camera for your Face ID scan, so every profile is a real person.",
          "recordAudioAndroid": true,
          "microphonePermission": "Soulink uses the microphone for the sound in Sparks you record."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Soulink uses your location once to fill in your city. You can always type it instead."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7c5cfc"
        }
      ],
      "expo-video",
      "expo-document-picker",
      "expo-sharing",
      "expo-updates"
    ],
    "extra": {
      "apiUrl": "https://soulink-xvbd.onrender.com/api",
      "router": {},
      "eas": {
        "projectId": "596a5a73-6ed7-49a2-94bb-d7e41c535620"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "soulinks-team",
    "updates": {
      "url": "https://u.expo.dev/596a5a73-6ed7-49a2-94bb-d7e41c535620",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
